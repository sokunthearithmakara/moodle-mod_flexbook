{{!
    @template mod_flexbook/canvas/startscreen

    The start screen over the player, in every mode: the flexbook's cover, whose button (#play) starts or
    resumes the book. With nothing to read on it, a returning learner skips past it (data-empty).

    Example context (json):
    {
        "startscreenempty": false,
        "cover": {
            "cmid": 12,
            "title": "Reflection: your journey",
            "button": "Start",
            "hasexpect": false,
            "hasoutcomes": false
        }
    }
}}
<div id="start-screen"
     class="w-100 position-absolute h-100 bottom-0 fb-start-screen"
     {{#startscreenempty}}data-empty="1"{{/startscreenempty}}
     role="region"
     aria-label="{{#str}}startscreen, mod_interactivevideo{{/str}}">
    {{#cover}}{{> mod_flexbook/cover}}{{/cover}}
</div>
