{{!
    @template mod_flexbook/canvas/startscreenpage

    The start screen on its own in a 16:9 frame, used when the book opens in a popup on Start or Resume.

    Example context (json):
    {
        "cmid": 12,
        "courseid": 2,
        "contextid": 34,
        "title": "Safety at the workshop",
        "new": true,
        "startscreendocument": false
    }
}}
<div id="flexbook-startframe"
     class="position-relative overflow-hidden"
     data-id="{{cmid}}"
     data-course="{{courseid}}"
     data-contextid="{{contextid}}"
     data-name="{{{title}}}">
    {{> mod_flexbook/canvas/startscreen}}
</div>
