{{!
    @template mod_flexbook/cover_outcomes

    The learning objectives on the flexbook's cover, with the learner's rating on each. Redrawn in place as the
    learner's progress is saved.

    Example context (json):
    {
        "outcomes": [
            {"name": "Describes the stages of the water cycle", "shortname": "WC-1", "rating": "Competent",
                "notrated": false},
            {"name": "Interprets a precipitation chart", "shortname": "WC-2", "rating": "No outcome",
                "notrated": true}
        ]
    }
}}
<div class="fb-cover-outcomes" data-region="fbcover-outcomes">
    <h3 class="fb-cover-outcomes-title">{{#str}}coveroutcomes, mod_flexbook{{/str}}</h3>
    <ol class="fb-cover-outcome-list">
        {{#outcomes}}
        <li>
            <span class="fb-cover-outcome-name">
                {{{name}}}{{#shortname}} <span class="fb-cover-muted">({{{shortname}}})</span>{{/shortname}}
            </span>
            <span class="badge iv-rounded-pill {{#notrated}}fb-cover-notrated{{/notrated}}{{^notrated}}fb-cover-rated{{/notrated}}">{{rating}}</span>
        </li>
        {{/outcomes}}
    </ol>
</div>
