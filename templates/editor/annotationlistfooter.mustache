{{!
    @template mod_flexbook/editor/annotationlistfooter

    Footer bar below the interaction list. Holds the paste action so it
    stays available even when the activity is empty (no bulk selection).

    Example context (json):
    {}
}}
<div id="annotation-list-footer"
     class="d-none d-flex align-items-center justify-content-start iv-border-top bg-light flex-shrink-0 px-2 py-1">
    <button id="annotation-list-paste"
            class="btn btn-sm btn-rounded btn-primary text-white border-0 d-flex align-items-center"
            type="button"
            title="{{#str}}paste, mod_flexbook{{/str}}"
            data-toggle="tooltip">
        <i class="bi bi-clipboard-plus iv-mr-1" aria-hidden="true"></i>
        {{#str}}paste, mod_flexbook{{/str}}
    </button>
</div>
