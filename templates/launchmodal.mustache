{{!
    @template mod_flexbook/launchmodal

    The full viewport popup that holds the book in an embed iframe.

    Example context (json):
    {
        "wwwroot": "https://example.com",
        "id": 12,
        "name": "Safety at the workshop"
    }
}}
<div class="fb-launch-bar d-flex align-items-center flex-shrink-0">
    <button type="button" data-action="hidemodal"
            class="btn border-0 p-1"
            aria-label="{{#str}}closebuttontitle, core{{/str}}"
            title="{{#str}}closebuttontitle, core{{/str}}">
        <i class="dir-rtl-hide bi bi-arrow-left fs-25px" aria-hidden="true"></i>
        <i class="dir-ltr-hide bi bi-arrow-right fs-25px" aria-hidden="true"></i>
    </button>
    <span class="h5 mb-0 iv-ml-2 text-truncate">{{name}}</span>
</div>
<iframe id="fbplayer"
    src="{{wwwroot}}/mod/flexbook/view.php?id={{id}}&embed=1&autostart=1"
    class="w-100 border-0 d-block flex-grow-1"
    allow="autoplay; fullscreen"
    allowfullscreen
    title="{{name}}">
</iframe>
